# JARVIS-X Environment Variables
# Copy this file to .env and fill in your actual credentials

# Database Credentials
QUESTDB_HTTP_PORT=9000
QUESTDB_PG_PORT=8812
REDIS_PASSWORD=jarvis_redis_password
POSTGRES_DB=jarvis_db
POSTGRES_USER=jarvis_user
POSTGRES_PASSWORD=jarvis_postgres_password

# OANDA API
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_account_id_here
OANDA_ENVIRONMENT=practice  # or 'live'

# Alpaca API (optional - for paper trading)
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Reddit API (for sentiment analysis)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_secret
REDDIT_USER_AGENT=JARVIS-X/1.0

# Twitter/X API (optional)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# OpenAI API (optional - for LLM validation)
OPENAI_API_KEY=your_openai_key_here

# DeepSeek API (optional - for cheap LLM calls)
DEEPSEEK_API_KEY=your_deepseek_key_here

# System Configuration
LOG_LEVEL=INFO
ENVIRONMENT=development  # development, paper, live
